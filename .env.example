# Copy this file to .env and fill in real values. Never commit .env.

# Master key for encrypting hotel API keys at rest (Fernet).
# Generate one with:  python scripts/generate_master_key.py
MASTER_ENCRYPTION_KEY=

# Database connection. SQLite for phase 1; switch to PostgreSQL later by
# changing this URL only (e.g. postgresql+psycopg://user:pass@host/dbname).
DATABASE_URL=sqlite:///./data/app.db

# Shared secret for the /admin/hotels endpoint (sent as X-Admin-Token header).
ADMIN_TOKEN=

# "app" logger level — DEBUG additionally logs the full AI prompt/context
# sent on every request. Off (INFO) by default.
LOG_LEVEL=INFO

# Which page GET / redirects to (see app/ui/routes.py): "website" ->
# /chatbot/nahariya (the general public site), "hotel" -> /demo (the
# WhatsApp-lookalike look used for hotel demos). Both pages are always
# reachable directly regardless of this setting — it only picks the
# default front door.
UI_MODE=website

# Provider models (optional overrides)
OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-opus-4-8

# Global WhatsApp messaging defaults (per-hotel overrides live in the
# hotel_messaging_settings table). "mock" logs instead of sending — use it
# for local dev with no real Twilio/Meta account.
MESSAGING_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# App Secret from Meta App Dashboard > App Settings > Basic (NOT the access
# token) — signs/verifies inbound webhook payloads (X-Hub-Signature-256).
META_APP_SECRET=

# Shared secret for the Meta-style GET /webhook/whatsapp verification handshake.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Daily WhatsApp send caps, to avoid an unexpectedly large bill.
WHATSAPP_DAILY_LIMIT_PER_PHONE=50
WHATSAPP_DAILY_LIMIT_PER_HOTEL=200
WHATSAPP_DAILY_LIMIT_GLOBAL=500
